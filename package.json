{
  "name": "cafco",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check": "astro check && eslint . && prettier --check .",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "astro": "7.1.6",
    "lenis": "1.3.25",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.2.0",
    "@astrojs/check": "0.9.10",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "astro-eslint-parser": "3.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-format": "2.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.astro": [
      "eslint --fix"
    ],
    "*.{json,md,yml,css}": [
      "prettier --write"
    ]
  }
}
