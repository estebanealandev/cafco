[Unit]
Description=Cafco application backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=APP_ROOT=/var/www/cafco
Environment=BACKUP_DIR=/var/backups/cafco
Environment=RETENTION_DAYS=14
ExecStart=/usr/local/bin/cafco-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/backups/cafco /var/www/cafco /var/log/cafco
