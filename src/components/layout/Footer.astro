---
import type { Locale } from '@/i18n/config'
import logo from '@/assets/brand/cafco-logo.svg'
import { EMAIL, IG_URL, WA_BASE, WA_PHONE_DISPLAY, WA_PHONE_TEL } from '@/data/site'
import { getMessages } from '@/i18n/messages'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getMessages(locale)
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="nav-logo">
          <img src={logo.src} alt="CAFCO" class="nav-logo-img" />
        </span>
        <p>{t.footer.brandDesc}</p>
      </div>
      <div class="footer-col">
        <h4>{t.footer.c1t}</h4>
        <ul>
          <li><a href="#modelos">{t.footer.c1l1}</a></li>
          <li><a href="#modelos">{t.footer.c1l2}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{t.footer.c2t}</h4>
        <ul>
          <li><a href="#nosotros">{t.footer.c2l1}</a></li>
          <li><a href="#materiales">{t.footer.c2l2}</a></li>
          <li><a href="#preparacion">{t.footer.c2l3}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{t.footer.c3t}</h4>
        <ul>
          <li>
            <a href={IG_URL} target="_blank" rel="noopener noreferrer">Instagram</a>
          </li>
          <li>
            <a href={WA_BASE} target="_blank" rel="noopener noreferrer">WhatsApp</a>
          </li>
          <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
          <li><a href={WA_PHONE_TEL}>{WA_PHONE_DISPLAY}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>{t.footer.bott}</p>
      <div class="footer-payment">
        <span>Sinpe Móvil</span>
        <span>Transferencia</span>
        <span>Efectivo</span>
      </div>
    </div>
  </div>
</footer>
